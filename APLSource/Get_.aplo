 res←file(opts Get_)sheets;wb;sh;n;row;c;cell;z;r;sheet;a;range;s;allsheets;defsheet;i;_NET
 ⍝ sheets: [1] name {[2] first row [3] first column (origin 1) [4] max rows [5] max cols}
 ⍝ name can contain wildcards
 ⍝ empty name means: last active sheet

 _NET←Init HELPERLIB

 res←⍬

 ⍝NPOI.SS.UserModel.(WorkbookFactory.SetImportOption ImportOption.SheetContentOnly)
 :If #.IsChar file
     wb←_NET.NPOI.SS.UserModel.WorkbookFactory.Create⊂file
 :Else
     wb←file
 :EndIf

 :Disposable wb

     allsheets←_NET.ArrayEWE.Helpers.WorksheetExtension.AllSheets wb
     defsheet←⊃allsheets

     :For sh :In ⊆sheets
         ⍝ /// s range←1((,⊃){⍺ ⍵}↓)'' 1 1 ⎕NULL ⎕NULL #.uDefault sh
         s←⊃sh ⋄ range←''
         :If '?*'(1∊∊)s
             i←s uFILTER allsheets
             s←allsheets[i]
         :ElseIf 0∊⍴⊃s
             s←defsheet
         :EndIf
         :If opts.EvaluateFormulas
             :Trap 90
                 _NET.NPOI.XSSF.UserModel.XSSFFormulaEvaluator.EvaluateAllFormulaCells wb
             :Else
                 ⎕←'⍝ Trapped error during formula refresh: '⎕DMX
             :EndTrap
         :EndIf

         :For sheet :In ⊆s

             sh←_NET.ArrayEWE.Helpers.WorksheetExtension.GetSheet wb sheet
             :Disposable sh
                 z←_NET.ArrayEWE.Helpers.WorksheetExtension.GetRange sh,range~⎕NULL
                 r←z.Values
                 :If opts.EmptyOnError
                     r←(⊂ERROR ⍬⊃⍨1+opts.EmptyOnError)@{z.Error}⊢r
                 :End
                 :If opts.EmptyOnNull
                     r←#.NoQNULL r
                 :EndIf
                 :If opts.ScalarToVector
                     r←,¨@(0=≢∘⍴¨)⊢r
                 :EndIf
                 :If opts.EmptyToChars
                     r←(⊂'')@(0=≢¨)⊢r
                 :EndIf
                 res,←⊂r
             :EndDisposable
         :EndFor
     :EndFor
 :EndDisposable
